# Required — get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Optional — Google OAuth access token for Gmail + Calendar
# One token covers both if it has the right scopes:
#   https://www.googleapis.com/auth/gmail.readonly
#   https://www.googleapis.com/auth/calendar.readonly
GMAIL_TOKEN=ya29.your_google_oauth_token_here

# If Calendar uses a separate token, set it here (otherwise falls back to GMAIL_TOKEN)
CALENDAR_TOKEN=ya29.your_google_oauth_token_here

# Server port (default: 3001)
PORT=3001
