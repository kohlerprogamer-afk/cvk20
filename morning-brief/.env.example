# Required
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional — Google OAuth access tokens for MCP integration
# Gmail access token (requires gmail.readonly scope)
GMAIL_TOKEN=ya29.your_google_oauth_token_here

# Google Calendar access token (requires calendar.readonly scope)
# If not set, falls back to GMAIL_TOKEN
CALENDAR_TOKEN=ya29.your_google_oauth_token_here

# Server port (default: 3001)
PORT=3001
